{
  "Print": {
    "prefix": "print",
    "body": ["print(${1:value})"],
    "description": "Print a value to the console"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) {",
      "\t${3:}",
      "}"
    ],
    "description": "Declare a function"
  },
  "Function with return type": {
    "prefix": "funct",
    "body": [
      "func ${1:name}(${2:a}: ${3:int}) -> ${4:int} {",
      "\treturn ${5:}",
      "}"
    ],
    "description": "Declare a typed function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\t${2:field} = ${3:value}",
      "",
      "\tfunc new(${4:}) {",
      "\t\tself.${2:field} = ${5:value}",
      "\t}",
      "}"
    ],
    "description": "Declare a class with a constructor"
  },
  "Class with parent": {
    "prefix": "classe",
    "body": [
      "class ${1:Child} extends ${2:Parent} {",
      "\t${3:}",
      "}"
    ],
    "description": "Declare a class that inherits"
  },
  "If / elif / else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2:}",
      "} else {",
      "\t${3:}",
      "}"
    ],
    "description": "A conditional with an else branch"
  },
  "For range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in 0..${2:n} {",
      "\t${3:}",
      "}"
    ],
    "description": "Loop over a range"
  },
  "For each": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t${3:}",
      "}"
    ],
    "description": "Loop over a list, map or string"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${2:}",
      "}"
    ],
    "description": "A while loop"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => ${3:}",
      "\t_ => ${4:}",
      "}"
    ],
    "description": "Match a value against patterns"
  },
  "Try / catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:}",
      "} catch as ${2:e} {",
      "\tprint(${2:e})",
      "}"
    ],
    "description": "Run code and handle errors"
  },
  "List comprehension": {
    "prefix": "lc",
    "body": ["[${1:expr} for ${2:x} in ${3:items}]"],
    "description": "Build a list from another sequence"
  },
  "Map comprehension": {
    "prefix": "mc",
    "body": ["{${1:k}: ${2:v} for ${3:x} in ${4:items}}"],
    "description": "Build a map from another sequence"
  },
  "Generator": {
    "prefix": "gen",
    "body": [
      "func ${1:name}(${2:}) {",
      "\tfor ${3:x} in ${4:items} {",
      "\t\tyield ${5:x}",
      "\t}",
      "}"
    ],
    "description": "A function that yields values"
  },
  "Decorator": {
    "prefix": "deco",
    "body": [
      "@${1:name}",
      "func ${2:name}(${3:}) {",
      "\t${4:}",
      "}"
    ],
    "description": "A decorated function"
  },
  "Import": {
    "prefix": "import",
    "body": ["import ${1:module}"],
    "description": "Import a module"
  },
  "Python interop": {
    "prefix": "pymod",
    "body": ["let ${1:m} = py.module(\"${2:math}\")"],
    "description": "Load a Python module"
  }
}
